{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
  "ignorePatterns": [
    "**/__tests__/**",
    "**/*.test.{ts,tsx,js,jsx}",
    "**/*.spec.{ts,tsx,js,jsx}",
    "e2e/**",
    "src/db/migrations/**",
    "src/components/ui/**",
    "scripts/**",
    "vitest.config.mts",
    "vitest.setup.ts",
    "playwright.config.ts"
  ],
  "ignoreDependencies": ["class-variance-authority", "radix-ui", "dotenv"],
  "ignoreExports": [
    {
      "file": "src/lib/jobs/ats-endpoints.ts",
      "exports": ["ATS_SOURCES", "AtsSource"]
    },
    {
      "file": "src/lib/jobs/ats-schemas.ts",
      "exports": [
        "greenhouseJobSchema",
        "leverJobSchema",
        "ashbyJobSchema",
        "GreenhouseJob",
        "GreenhouseJobsResponse",
        "LeverJob",
        "LeverJobsResponse",
        "AshbyJob",
        "AshbyJobsResponse"
      ]
    },
    {
      "file": "src/lib/jobs/dashboard-queries.ts",
      "exports": ["getApprovedMatches"]
    },
    {
      "file": "src/lib/jobs/gate-3.ts",
      "exports": ["gate3VerdictSchema", "buildGate3Prompt"]
    },
    {
      "file": "src/lib/jobs/gate-zero.ts",
      "exports": ["GATE_ZERO_REGEX"]
    },
    {
      "file": "src/lib/jobs/job-normalizer.ts",
      "exports": ["scanTagsRegex", "extractTagsLLM"]
    },
    {
      "file": "src/lib/jobs/poller/job-repository.ts",
      "exports": ["markUnseenJobsStale"]
    },
    {
      "file": "src/lib/jobs/poller/schemas.ts",
      "exports": [
        "pollerRunEventSchema",
        "jobIngestedEventSchema",
        "PollCompanyEvent",
        "PollerRunEvent",
        "JobIngestedEvent"
      ]
    },
    {
      "file": "src/lib/jobs/seeders/company-repository.ts",
      "exports": ["companyExists"]
    },
    {
      "file": "src/lib/jobs/seeders/hn-schemas.ts",
      "exports": ["hnAlgoliaHitSchema"]
    },
    {
      "file": "src/lib/jobs/seeders/schemas.ts",
      "exports": [
        "atsSourceSchema",
        "discoverySourceSchema",
        "AtsSource",
        "DiscoverySource"
      ]
    },
    {
      "file": "src/lib/jobs/seeders/url-parser.ts",
      "exports": ["extractUrls", "parseAtsUrl", "ClassifiedUrl"]
    },
    {
      "file": "src/lib/jobs/tech-tags.ts",
      "exports": [
        "CANONICAL_TAG_SLUGS",
        "TAGS_BY_CATEGORY",
        "normalizeToCanonicalTag",
        "isPersonaDefining"
      ]
    },
    {
      "file": "src/lib/onboarding/recompute-tags.ts",
      "exports": ["mergeOverlappingRanges", "sumYearsFromRanges"]
    },
    {
      "file": "src/lib/blog/posts.ts",
      "exports": ["getAllPostsRaw"]
    },
    {
      "file": "src/lib/jobs/quality/fusion-score.ts",
      "exports": ["getDiscoverySources", "hasBeenDiscoveredBy"]
    },
    {
      "file": "src/lib/jobs/quality/quality-flywheel.ts",
      "exports": ["calculateQualityScore", "determineTierAction"]
    },
    {
      "file": "src/app/api/admin/diagnostic/openai/route.ts",
      "exports": ["OpenAIDiagnosticResponse"]
    },
    {
      "file": "src/lib/jobs/storage-check.ts",
      "exports": ["STORAGE_WARNING_THRESHOLD", "STORAGE_CRITICAL_THRESHOLD"]
    },
    {
      "file": "src/lib/jobs/poller/cleanup-queries.ts",
      "exports": [
        "purgeNormalizationFailed",
        "purgeRejected",
        "purgeGone",
        "purgeStale",
        "purgeActiveFifo"
      ]
    },
    {
      "file": "src/lib/jobs/remote-scope-extractor.ts",
      "exports": [
        "step1AtsNativeTrust",
        "extractMainContent",
        "step1RegexHardSignals",
        "stripCompanyHq",
        "isHardFailRetryable"
      ]
    }
  ],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": [
      "src/components/auth/SignInForm.tsx",
      "src/components/auth/SignUpForm.tsx"
    ]
  },
  "rules": {
    "unused-dependencies": "warn",
    "circular-dependencies": "off"
  }
}
