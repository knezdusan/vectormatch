{
  "version": 1,
  "permissions": {
    "allow": ["Exec(cp)", "Exec(rm)", "Exec(npx)", "Exec(grep)"]
  },
  "mcpServers": {
    "shadcn": {
      "transport": "STDIO",
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "neon": {
      "url": "https://mcp.neon.tech/mcp",
      "transport": "http"
    },
    "playwright": {
      "transport": "STDIO",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "fallow": {
      "transport": "STDIO",
      "command": "npx",
      "args": ["-y", "fallow-mcp"]
    },
    "bigquery": {
      "transport": "STDIO",
      "command": "npx",
      "args": [
        "-y",
        "@toolbox-sdk/server",
        "--prebuilt",
        "bigquery",
        "--stdio"
      ],
      "env": {
        "BIGQUERY_PROJECT": "vactormatch-seeder"
      }
    },
    "inngest": {
      "transport": "HTTP",
      "url": "http://127.0.0.1:8288/mcp"
    }
  },
  "exclude": [
    "**/node_modules/**",
    "**/.next/**",
    "**/build/**",
    "**/dist/**",
    "**/.git/**",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml"
  ]
}
