{
  "version": 1,
  "permissions": {
    "allow": ["Exec(cp)", "Exec(rm)", "Exec(npx)", "Exec(grep)"]
  },
  "mcpServers": {
    "shadcn": {
      "transport": "STDIO",
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "neon": {
      "transport": "STDIO",
      "command": "npx",
      "args": ["-y", "mcp-remote@latest", "https://mcp.neon.tech/mcp"]
    },
    "playwright": {
      "transport": "STDIO",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "fallow": {
      "transport": "STDIO",
      "command": "npx",
      "args": ["-y", "fallow-mcp"]
    }
  },
  "exclude": [
    "**/node_modules/**",
    "**/.next/**",
    "**/build/**",
    "**/dist/**",
    "**/.git/**",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml"
  ]
}
