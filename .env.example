# VectorMatch application public url
NEXT_PUBLIC_SITE_URL=""

# Database
DATABASE_URL=""
# Emergency override for the storage/backlog ingestion guard. Set to "1" to
# allow new job ingestion even when the database is near the storage limit or
# the normalizer backlog is high. Use with caution.
FORCE_INGESTION=""

# Better Auth
BETTER_AUTH_SECRET=you-secret-here
BETTER_AUTH_URL=your-app-url-here

# Social Auth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Resend
RESEND_API_KEY=""
# Sender address for transactional emails. Must use a domain verified in Resend.
# Example: VectorMatch <noreply@vectormatch.dev>
RESEND_FROM_EMAIL=""
# Webhook signing secret for verifying inbound email webhooks.
# Found in the Resend dashboard → Webhooks → your webhook → Signing Secret.
RESEND_WEBHOOK_SECRET=""
# Comma-separated list of admin emails that receive storage/backlog alerts.
# Example: admin@vectormatch.dev,ops@vectormatch.dev
ADMIN_ALERT_EMAIL=""

# OpenAI (Module A — CV extraction + embeddings)
OPENAI_API_KEY=""

# OpenRouter API keys for ACP agents in Devin Desktop/Windsurf
# (not consumed directly by the VectorMatch application)
OPENROUTER_API_KEY=""
DIRAC_OPENROUTER_API_KEY=""

# Module C — Matching Engine
# Gate 2 HNSW cosine distance threshold (lower = stricter). Tunable without a
# redeploy. Default 0.50 (similarity > 0.50). Raise to filter more, lower to
# admit more candidates into Gate 3.
GATE2_MAX_COSINE_DISTANCE=0.50

# Brave Search API key for B2/D1 source functions (Sprint 3 Task 7 — replaced
# Google CSE). Free plan includes monthly credits. Sign up at
# https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=""

# D27: Inngest removed — pg-boss is now the sole scheduler.
# All INNGEST_* env vars have been removed.
# The scheduler runs in-process using pg-boss (Postgres-backed job queue).

# Neon API — HISTORICAL / DORMANT. Used by the storage monitor to check
# synthetic_storage_size, which was the value Neon enforced against the 512 MB
# free-tier limit. The app database was migrated to VPS Postgres on July 20 2026
# (D20) — these vars are no longer needed for production. The neon-api.ts module
# and hourlyStorageMonitor function remain in the codebase but are dormant.
# Retained only if the disaster-recovery Neon database needs to be monitored.
#
# Create a key at: https://console.neon.tech/app/settings/api-keys
# The project ID is in the Neon console URL or via `neon projects list`.
NEON_API_KEY=""
NEON_PROJECT_ID=""

# Redis — Distributed rate limiting for ATS polling (Sprint 8)
#
# When set, the Phalanx Poller uses Bottleneck's Redis datastore to enforce the
# "max 2 req/s per ATS platform" cap GLOBALLY across all Inngest worker
# processes. Without Redis, each worker gets its own in-process limiter and the
# aggregate rate can exceed 2 req/s, risking IP bans from ATS platforms.
#
# Self-hosted on Coolify (same Docker network as the app). Use a plain redis://
# URL for same-network traffic — no TLS needed.
#
# When unset (local dev, CI): in-process rate limiting is used. This is correct
# for single-process development but NOT safe for multi-worker production.
#
# Failure mode: if Redis is configured but unreachable, Bottleneck.schedule()
# throws after ioredis retries. The caller (fetchJobsFromAts) catches this and
# returns a "network" error, which the circuit breaker treats as a degraded
# source. This is intentional — it's safer to stall ingestion than to risk
# uncoordinated requests that could trigger an ATS IP ban.
REDIS_URL=""
